# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e EKLENMEZ.

# Google Cloud Console > APIs & Services > Credentials > "OAuth client ID" > Uygulama türü: Masaüstü uygulaması
# Kapsam: https://www.googleapis.com/auth/gmail.readonly (SADECE OKUMA)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub (depo oluşturma / Actions için)
GITHUB_TOKEN=
